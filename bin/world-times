#!/usr/bin/env python3
"""Current local times for a range of world cities, as JSON.

Feeds the uptime-clock widget's right-click "world times" panel
(bar/modules/uptime.qml). Entries are sorted alphabetically by city, with
the machine's own timezone flagged `local`. Runs once per second while the
panel is open, so a fresh python spawn is cheap and there is no state to go
stale.

Output schema:
  {"local": "<IANA zone>", "entries": [
    {"city": str, "zone": str, "time": "HH:MM:SS", "day": "Mon",
     "offset": "UTC-5"/"UTC+5:30"}, ...
  ]}

Subcommands (for adding cities beyond the curated list):
  (no args)          current times for curated + custom cities
  search <query>     fuzzy-match IANA timezones, emit {"matches":[...]}
  add <zone> [label]   persist a custom city (zone label = leaf unless given)
  remove <zone>?     remove a custom city by exact IANA zone

Custom cities persist in world-times-custom.json next to this script, merged
into the canonical output (labelled as-is, still sorted and local-tagged).
"""

import json
import pathlib
import subprocess
import sys
import unicodedata
from datetime import datetime

try:
    from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
    import zoneinfo
except ImportError:  # python < 3.9
    sys.stderr.write("world-times: zoneinfo (python 3.9+) required\n")
    sys.exit(2)

# (label, IANA zone). Coverage spans UTC-11 .. UTC+14; several zones are
# shared by more than one city (Mumbai/Kolkata, Rio/Sao Paulo) on purpose.
_CITIES = [
    ("Adelaide", "Australia/Adelaide"),
    ("Anchorage", "America/Anchorage"),
    ("Apia", "Pacific/Apia"),
